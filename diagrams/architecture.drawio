        <!-- Object Storage -->
        <mxCell id="storage" value="&lt;b&gt;Object Storage&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#666&quot;&gt;Annotated frames, reports,&lt;br/&gt;model weights (S3/GCS/local)&lt;/font/&gt;" style="shape=mxgraph.c4.database;fillColor=#85BBF0;fontColor=#000;strokeColor=#6D9DC5;" vertex="1" parent="1">
