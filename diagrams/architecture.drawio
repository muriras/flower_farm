  <diagram id="c4-context" name="C4 Context">
    <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title -->
        <mxCell id="title" value="&lt;b&gt;C4 System Context — Flower Farm Drone CV System&lt;/b&gt;" style="text;html=1;fontSize=18;align=center;" vertex="1" parent="1">
          <mxGeometry x="400" y="20" width="800" height="40" as="geometry"/>
        </mxCell>

        <!-- Farm Manager -->
        <mxCell id="farmer" value="&lt;b&gt;Farm Manager&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#666&quot;&gt;Monitors flower health,&lt;br/&gt;reviews reports, takes&lt;br/&gt;action on disease hotspots&lt;/font/&gt;" style="shape=mxgraph.c4.person;fillColor=#08427B;fontColor=#fff;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="100" y="350" width="120" height="120" as="geometry"/>
        </mxCell>

        <!-- Drone Operator -->
        <mxCell id="pilot" value="&lt;b&gt;Drone Operator&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#666&quot;&gt;Deploys drone fleet,&lt;br/&gt;handles takeoff/landing,&lt;br/&gt;monitors battery&lt;/font/&gt;" style="shape=mxgraph.c4.person;fillColor=#08427B;fontColor=#fff;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="100" y="550" width="120" height="120" as="geometry"/>
        </mxCell>

        <!-- CV System (central) -->
        <mxCell id="system" value="&lt;b&gt;Flower Farm CV System&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#666&quot;&gt;Distributed computer vision system&lt;br/&gt;that detects flowers, assesses health,&lt;br/&gt;and generates farm-wide reports&lt;/font/&gt;" style="shape=mxgraph.c4.container;fillColor=#1168BD;fontColor=#fff;strokeColor=#0B4A82;container=1;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="600" y="300" width="360" height="200" as="geometry"/>
        </mxCell>

        <!-- Drone Fleet -->
        <mxCell id="drones" value="&lt;b&gt;Drone Fleet&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#666&quot;&gt;Physical drones with&lt;br/&gt;cameras flying lawnmower&lt;br/&gt;patterns over the farm&lt;/font/&gt;" style="shape=mxgraph.c4.component;fillColor=#85BBF0;fontColor=#000;strokeColor=#6D9DC5;" vertex="1" parent="1">
          <mxGeometry x="1200" y="300" width="200" height="100" as="geometry"/>
        </mxCell>

        <!-- Ray Cluster -->
        <mxCell id="ray_cluster" value="&lt;b&gt;Ray Cluster&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#666&quot;&gt;Distributed compute cluster&lt;br/&gt;for parallel drone processing&lt;/font/&gt;" style="shape=mxgraph.c4.component;fillColor=#85BBF0;fontColor=#000;strokeColor=#6D9DC5;" vertex="1" parent="1">
          <mxGeometry x="1200" y="450" width="200" height="100" as="geometry"/>
